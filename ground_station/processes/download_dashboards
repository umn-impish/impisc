#!/bin/bash -l
# Do the -l option so the path gets updated from .bashrc
# Use gcx to pull the dashboard JSON files from Grafana.
# The API token used is automatically generated during
# the ground station deployment.

source /usr/local/bin/gcx_token.env
/home/grimpish/.local/bin/gcx login default \
  --server http://localhost:3000 \
  --token $GRAFANA_API_TOKEN \
  --yes
/home/grimpish/.local/bin/gcx resources pull dashboards \
  --path $HOME/dashboards_json \
  --config /home/grimpish/.config/gcx/config.yaml
# attempt to copy to usb
mkdir -p /mnt/gssecrets-usb/
mount /dev/sdb1 /mnt/gssecrets-usb/
cp -r $HOME/dashboards_json /mnt/gssecrets-usb/
umount /mnt/gssecrets-usb/

[Unit]
Description=Forward commands from Grafana to IMPISH
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/usr/local/bin/variables.env
EnvironmentFile=/usr/local/bin/gs-variables.env
EnvironmentFile=/usr/local/bin/grafana.env
ExecStart=command_forwarder -t ${COMMAND_HTTP_PORT} -b ${COMMAND_ROUTER_PORT} -i ${COMMAND_ENDPOINT_IP} -p ${COMMAND_ROUTER_PORT}
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
User=grimpish

[Install]
WantedBy=multi-user.target

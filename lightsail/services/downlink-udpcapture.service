[Unit]
Description=Capture packets sent from IMPISH to lightsail; save locally and forward to the ground station
After=network-online.target

[Service]
User=impish
EnvironmentFile=/data/config/lightsail.env
ExecStart=udpcapture --port ${PACKETS_FROM_IMPISH_PORT} \
    --base-filename '/data/packets/dump' \
    --file-lifetime 30 \
    --forward-addrs ${GROUNDSTATION_IP}:${PACKETS_TO_GS_PORT} \
    --post-process-cmd 'bzip2 $out_file'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
